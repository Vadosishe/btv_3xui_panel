# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/vpn_panel_db?schema=public"

# Auth Settings
JWT_SECRET="generate_a_random_long_secret_string"
NEXTAUTH_URL="http://your-panel-domain-or-ip:3000"

# (Optional) API key for diagnostic/debug endpoint. Falls back to sha256(JWT_SECRET) if empty.
DIAGNOSTIC_API_KEY="your_custom_diagnostic_api_key_here"

# 3XUI Main Server credentials
XUI_API_URL="http://your-xui-main-panel-ip:2053"
XUI_USERNAME="admin"
XUI_PASSWORD="your_3xui_password"

# Telegram Alerts (Optional)
TG_BOT_TOKEN="your_bot_token"
TG_ADMIN_CHAT_IDS="chat_id1,chat_id2"

# Synchronization
SYNC_INTERVAL_MINUTES="15"
